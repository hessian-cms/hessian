{
  "name": "hessian-cms",
  "version": "0.0.0",
  "main": "index.js",
  "repository": "https://github.com/hessian-cms/hessian.git",
  "author": "no4any",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces run build",
    "build:core": "yarn workspace @hessian-cms/core run build",
    "build:doc": "yarn workspace @hessian-cms/doc run build",

    "test": "yarn workspaces run test",
    "test:core": "yarn workspace @hessian-cms/core run test",
    "test:watch:core": "yarn workspace @hessian-cms/core run test:watch",
    "test:watchAll:core": "yarn workspace @hessian-cms/core run test:watchAll"
  },
  "devDependencies": {
    "yarn": "^1.22.22"
  }
}
